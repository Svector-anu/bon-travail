# ---- Storage -------------------------------------------------------------
# SQLite file (node:sqlite, no native deps). Created on first run.
DATABASE_PATH=./data/proofwork.db

# ---- Chain ---------------------------------------------------------------
# rpc     = read Arc testnet over JSON-RPC (verification + task sourcing)
# fixture = recorded Arc testnet transactions, offline + deterministic
CHAIN_READER=rpc
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_EXPLORER_URL=https://testnet.arcscan.app

# ---- Payments (fails closed if unset) ------------------------------------
# mock = simulated ledger, every payout labelled SIMULATED in the UI
# arc  = real USDC transfers on Arc testnet from a capped hot wallet
PAYMENT_PROVIDER=mock
# Required for PAYMENT_PROVIDER=arc. Never commit this. Testnet only.
# ARC_PAYER_PRIVATE_KEY=0x...

# Hard spending policy, enforced in front of every provider (USDC).
MAX_REWARD_USDC=1
DAILY_PAYOUT_CAP_USDC=10
MAX_OUTSTANDING_ESCROW_USDC=5

# ---- Agent ---------------------------------------------------------------
# Bearer token for agent-only endpoints (tick, create, verify, release, refund).
# Generate with: openssl rand -hex 32
AGENT_API_TOKEN=
TASK_REWARD_USDC=1
TASK_DEADLINE_SECONDS=21600
CLAIM_TTL_SECONDS=600
TARGET_OPEN_TASKS=1
# How often the scheduler (Aeon or agent:loop) is expected to tick.
AGENT_EXPECTED_INTERVAL_SECONDS=300

# ---- Notifications (optional) -------------------------------------------
# Public base URL used in receipt links returned to Aeon.
PUBLIC_BASE_URL=http://localhost:3000

# ---- Sign-in (optional, recommended for anything public) ----------------
# Privy gives workers email / Google / X login with an auto-created wallet.
# When set, every claim must carry a Privy identity token and pay out to a
# wallet linked to that person; one answer per person per task.
# Dashboard: enable "Return user data in an identity token"
# (User management > Authentication > Advanced) and add your domains.
# Unset = open mode (paste any payout address), for local dev and tests.
# NEXT_PUBLIC_PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# Optional, avoids fetching the key: Configuration > App settings > Verification key
# PRIVY_VERIFICATION_KEY=
