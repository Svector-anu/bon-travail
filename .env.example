# ---- Storage -------------------------------------------------------------
# Postgres in production (Neon via the Vercel integration sets DATABASE_URL).
# Without DATABASE_URL the app runs on an embedded Postgres (PGlite) in this
# directory, created on first run.
# DATABASE_URL=postgres://...
DATABASE_PATH=./data/pglite

# ---- GitHub ----------------------------------------------------------------
# Read-only token used to watch workflow runs, read job logs and verify PRs.
# A fine-grained token with "Public repositories (read-only)" is enough for
# public repos; add Actions + Pull requests + Contents read for private ones.
# Without it, GitHub features are disabled (fail closed).
GITHUB_TOKEN=
# How often the agent tick re-reads each watched repository.
OBSERVE_INTERVAL_SECONDS=60
# A submitted fix still waiting on CI this long after the deadline fails.
CI_VERIFY_GRACE_SECONDS=21600

# ---- Engineer console --------------------------------------------------------
# The only way to approve, externalize, set rewards and allowlists.
# Unset = the console and every owner endpoint are disabled.
# Generate with: openssl rand -hex 32
OWNER_ACCESS_TOKEN=

# ---- Chain ---------------------------------------------------------------
# rpc     = read Arc testnet over JSON-RPC
# fixture = recorded Arc testnet transactions, offline + deterministic
CHAIN_READER=rpc
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_EXPLORER_URL=https://testnet.arcscan.app

# ---- Payments (fails closed if unset) ------------------------------------
# mock       = simulated ledger, every payout labelled SIMULATED in the UI
# arc        = direct USDC transfers on Arc testnet from a capped hot wallet
# arc-escrow = fund, release and refund through the ProofworkEscrow contract
PAYMENT_PROVIDER=mock
# Required for arc and arc-escrow. Never commit this. Testnet only.
# ARC_PAYER_PRIVATE_KEY=0x...
# Required for arc-escrow. See docs/ESCROW.md.
# ARC_ESCROW_ADDRESS=0xe8165f9eba6f2e26b552146506abd5df05ae4dd8
# Prefix of every escrow task key. Give each deployment its own when several
# share one contract (task ids restart per database).
ESCROW_NAMESPACE=proofwork-local

# Hard spending policy, enforced in front of every provider (USDC).
MAX_REWARD_USDC=1
DAILY_PAYOUT_CAP_USDC=10
MAX_OUTSTANDING_ESCROW_USDC=5

# ---- Agent ---------------------------------------------------------------
# Bearer token for agent-only endpoints (tick, findings, investigation,
# verify, release, refund). Aeon holds it as PROOFWORK_AGENT_TOKEN.
# Generate with: openssl rand -hex 32
AGENT_API_TOKEN=
# Vercel Cron sends this as a bearer token to /api/cron/tick (fallback schedule).
# CRON_SECRET=
# How often the scheduler (Aeon or agent:loop) is expected to tick.
AGENT_EXPECTED_INTERVAL_SECONDS=600

# ---- Rail tests (optional) -----------------------------------------------
# Arc transaction fact-checks the agent creates on its own to exercise the
# payment loop. 0 disables them; work packages are only ever created by an
# engineer.
TARGET_OPEN_TASKS=0
TASK_REWARD_USDC=1
TASK_DEADLINE_SECONDS=21600
CLAIM_TTL_SECONDS=600

# Public base URL used in receipt links returned to Aeon.
PUBLIC_BASE_URL=http://localhost:3000

# ---- Rail-test sign-in (optional) ----------------------------------------
# Privy gives rail-test workers email / Google / X login with a wallet.
# Work packages never need it: GitHub proves who opened the PR.
# NEXT_PUBLIC_PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_VERIFICATION_KEY=
